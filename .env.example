# Supabase
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# RevenueCat (public SDK keys — per-platform)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=""

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""

# App URLs (legal links on the paywall)
EXPO_PUBLIC_TERMS_URL=""
EXPO_PUBLIC_PRIVACY_URL=""

# PostHog (public project key — write-only, safe to ship in the client).
# Settings → Project → Project API Key. The host is the project's REGION, not a
# settings field: EU Cloud → https://eu.i.posthog.com, US Cloud → https://us.i.posthog.com
# Without a key the SDK no-ops and the app runs analytics-free.
# The Edge Functions use the SAME key, set as Supabase secrets:
#   supabase secrets set POSTHOG_API_KEY="phc_..." POSTHOG_HOST="https://eu.i.posthog.com"
EXPO_PUBLIC_POSTHOG_API_KEY=""
EXPO_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"