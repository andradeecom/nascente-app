# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Bible-DB build scripts — local one-off tooling, not shipped (see
# .docs/bible-translation-licensing.md → "Build scripts & sources").
scripts/build-bible-dbs.mjs
scripts/build-bible-dbs-helloao.mjs
scripts/lib/

# Ruby / Fastlane — gems are vendored locally; Gemfile.lock IS committed so CI
# resolves identical versions.
vendor/bundle/
.bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
build/

# Supabase 
supabase/.temp/*
supabase/.env
supabase/.env.local
supabase/.env.*.local

# Hot Updater (OTA) — provider credentials and signing keys never enter git.
# The public key IS committed: it is the trust anchor embedded in the binary.
.env.hotupdater
keys/*
!keys/public-key.pem
# hot-updater
keys/private-key.pem
# hot-updater
.hot-updater/output
.hot-updater/log
