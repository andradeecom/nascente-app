{
  "expo": {
    "name": "Nascente",
    "slug": "nascente",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nascente",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/nascente.icon",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "es", "pt"]
      },
      "bundleIdentifier": "com.andradee.nascente"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andradee.nascente"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE0",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "pt"],
            "android": ["en", "es", "pt"]
          }
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.397336416856-dosvk0v405lhmucnd3ietr86lravpj61"
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
              "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
              "./assets/fonts/Lato-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Literata",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Source Serif 4",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Lato",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lato-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
