{
  "expo": {
    "name": "Nascente",
    "slug": "nascente",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nascenteapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/nascente.icon",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "es", "pt"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.andradee.nascenteapp",
      "supportsTablet": false,
      "appleTeamId": "URV3D9PRX2",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andradee.nascenteapp",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE0",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "pt"],
            "android": ["en", "es", "pt"]
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.815534166888-okj4ga5h2q78b41jtg2bmqcsd8q8aqsf"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nascente to access your photos so you can set a profile picture."
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
              "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
              "./assets/fonts/Lato-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Literata",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Literata-VariableFont_opsz,wght.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Source Serif 4",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SourceSerif4-VariableFont_opsz,wght.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Lato",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lato-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-status-bar",
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
