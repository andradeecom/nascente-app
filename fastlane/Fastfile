# iOS release pipeline. Android is deliberately absent — see
# .docs/notes.md → "Android deferred — iOS-only launch".
#
# Run locally with:  bundle exec fastlane ios beta
# In CI:             .github/workflows/release-ios.yml
#
# Two things make this project different from a stock RN Fastfile:
#
# 1. `ios/` is GITIGNORED and regenerated by Expo prebuild (CNG). The lane runs
#    prebuild itself, so it never assumes a checked-in Xcode project. This also
#    means anything hand-edited in `ios/` is lost — native config belongs in
#    app.json / config plugins.
#
# 2. Signing uses an App Store Connect API key (.p8) rather than `match`, so
#    there is no second certificates repo to maintain and no Apple ID password
#    or 2FA session in CI. The key is passed as base64 through a single secret.

default_platform(:ios)

# The workspace/scheme names prebuild generates from app.json's `name`.
WORKSPACE = 'ios/Nascente.xcworkspace'
SCHEME    = 'Nascente'
IPA_PATH  = 'build/Nascente.ipa'

platform :ios do
  # Builds an App Store Connect API token from env. Used by every lane that
  # talks to Apple. The key itself is base64 in ASC_KEY_P8_BASE64 so it survives
  # being stored as a single-line GitHub secret.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8_BASE64'),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc 'Regenerate the native iOS project from app.json (CNG)'
  lane :prebuild do
    # --no-install: JS deps are already installed by the workflow (pnpm), and
    # letting prebuild run its own install would use the wrong package manager.
    sh('cd .. && pnpm exec expo prebuild --platform ios --no-install')
    cocoapods(podfile: 'ios/Podfile', use_bundle_exec: false)
  end

  desc 'Build a signed release IPA and upload it to TestFlight'
  lane :beta do
    api_key = asc_api_key

    prebuild

    # Manual signing with a downloaded App Store profile. `get_provisioning_profile`
    # (sigh) creates or reuses an App Store distribution profile for the bundle id
    # and installs it on the runner.
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: 'com.andradee.nascenteapp')

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: 'Release',
      output_directory: 'build',
      output_name: 'Nascente.ipa',
      clean: true,
      export_method: 'app-store',
      # Expo's generated project uses automatic signing; force manual so the
      # profile sigh just installed is the one actually used.
      export_options: {
        signingStyle: 'manual',
        provisioningProfiles: {
          'com.andradee.nascenteapp' => ENV['SIGH_PROFILE_NAME'] || lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    # skip_waiting_for_build_processing keeps the macOS runner from idling
    # (and billing) while Apple processes the build. The tradeoff: compliance
    # and TestFlight distribution have to be handled in App Store Connect.
    upload_to_testflight(
      api_key: api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc 'Upload the latest TestFlight build to App Store review'
  lane :release do
    api_key = asc_api_key

    # Does NOT rebuild — promotes what `beta` already uploaded, so the binary
    # that went through TestFlight is the exact one submitted.
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
