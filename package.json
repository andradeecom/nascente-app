    "test:node": "jest --selectProjects node",
    "test:hooks": "jest --selectProjects hooks",
    "test:ci": "jest --ci --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "prepare": "husky",
    "pre-build": "expo prebuild --clean",
    "clean-project": "sh ./scripts/clean-project.sh",
    "expo:check:deps": "expo install --check",
    "expo:update:deps": "expo install --fix"
